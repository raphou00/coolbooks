# Local test setup: copy to .env (cp local.example.env .env) and run `bun run local`.
# Everything runs on your machine. Nothing here needs a cloud account.

LOCAL_MODE=true
APP_URL=http://localhost:3000

# DynamoDB Local (started by docker compose)
AWS_REGION=eu-central-2
DYNAMODB_ENDPOINT=http://localhost:8001
DATA_DYNAMODB_TABLE=bibliboo-local-data
RATE_LIMITS_DYNAMODB_TABLE=bibliboo-local-rate-limits

# Files are stored in .local/files and served by the dev server
CLOUDFRONT_URL=http://localhost:3000/api/dev/files
NEXT_PUBLIC_CLOUDFRONT_URL=http://localhost:3000/api/dev/files

# AI: "mock" draws placeholder pictures for free.
# "real" uses OpenRouter (costs money, see todo.md for prices).
AI_MODE=mock
# Monthly AI spend cap in USD (mock mode counts fake spend, so a low value
# such as 2 lets you test what happens when the budget runs out)
AI_MONTHLY_BUDGET_USD=50
# Optional: a different image model on OpenRouter
# IMAGE_MODEL=google/gemini-3-pro-image-preview
OPENROUTER_API_KEY=
# Only needed for real moderation and "Boo reads" audio
OPENAI_API_KEY=

# Payments: "mock" shows a local test-payment page.
# "stripe" uses Stripe test mode: set the keys below and run
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
PAYMENTS=mock

# Offer the printed hardcover at checkout
NEXT_PUBLIC_PRINT_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Emails go to the local inbox at http://localhost:3000/api/dev/emails
ADMIN_EMAIL=admin@bibliboo.local

# Days after delivery before the review email (0 = right away, for testing)
REVIEW_DELAY_DAYS=0

# Optional: Google login (leave empty to use email + password)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
