generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  USD
  EUR
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  password      String?
  currency      Currency  @default(USD)
  locale        String?
  role          Role      @default(USER)
  girls         String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  tokens        Token[]
}

model Session {
  id        String   @id @default(uuid())
  ip        String?
  browser   String?
  os        String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Token {
  id        String   @id @default(uuid())
  token     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Girl {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  bio       String
  avatar    String
  cover     String
  medias    Media[]
  price     Float
  origin    String
  likes     Int      @default(0)
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id          String   @id @default(uuid())
  images      Image[]
  videos      Video[]
  description String
  Girl        Girl    @relation(fields: [girlId], references: [id])
  girlId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Image {
  id        String   @id @default(uuid())
  src       String
  blurred   String
  width     Int
  height    Int
  free      Boolean
  Media     Media    @relation(fields: [mediaId], references: [id])
  mediaId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Video {
  id        String   @id @default(uuid())
  src       String
  blurred   String
  thumbnail String
  width     Int
  height    Int
  time      Int
  free      Boolean
  Media     Media    @relation(fields: [mediaId], references: [id])
  mediaId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
