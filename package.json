{
    "name": "bibliboo",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "local": "docker compose up -d && bun run db:local && next dev",
        "build": "next build",
        "start": "next start",
        "wip": "bun run fmt:write && git add . && git commit -m \"WIP\" && git push",
        "type-check": "tsc --noEmit",
        "lint": "eslint",
        "fmt:write": "prettier --write \"**/*.{ts,tsx,mdx,json}\" --cache --experimental-ternaries",
        "fmt:check": "prettier --check \"**/*.{ts,tsx,mdx,json}\" --cache",
        "pulumi:login": "cd aws && pulumi login s3://coolbooks-pulumi-state-2921",
        "deploy:dev": "bun run pulumi:login && cd aws && pulumi up --stack dev -y",
        "destroy:dev": "bun run pulumi:login && cd aws && pulumi down --stack dev -y",
        "db:local": "bun scripts/dynamodb-local.ts",
        "db:migrate": "bun scripts/migrate-postgres-to-dynamodb.ts"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.1161.0",
        "@aws-sdk/client-lambda": "^3.1161.0",
        "@aws-sdk/client-s3": "^3.1161.0",
        "@aws-sdk/lib-dynamodb": "^3.1161.0",
        "@hookform/resolvers": "^7.0.2",
        "@pilcrowjs/object-parser": "^0.0.4",
        "@radix-ui/react-select": "^2.4.1",
        "@react-email/components": "^1.0.12",
        "@stripe/react-stripe-js": "^7.0.1",
        "@stripe/stripe-js": "^10.2.1",
        "@t3-oss/env-nextjs": "^0.13.11",
        "@vercel/functions": "^3.10.6",
        "arctic": "^3.7.0",
        "autoprefixer": "^10.6.2",
        "axios": "^1.21.0",
        "bcrypt": "^6.0.0",
        "caniuse-lite": "^1.0.30001820",
        "canvas-confetti": "^1.9.4",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "fabric": "^7.4.0",
        "file-saver": "^2.0.5",
        "framer-motion": "^14.9.0",
        "input-otp": "^1.5.0",
        "jspdf": "^4.2.1",
        "lucia": "^3.2.2",
        "lucide-react": "^1.67.0",
        "motion": "^14.9.0",
        "next": "^16.4.5",
        "next-intl": "^4.14.9",
        "next-themes": "^0.4.6",
        "openai": "^7.49.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-hot-toast": "^2.6.1",
        "resend": "^6.37.0",
        "sharp": "^0.35.5",
        "stripe": "^23.1.0",
        "swr": "^2.5.1",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@pulumi/aws": "^7.53.0",
        "@pulumi/pulumi": "^3.273.0",
        "@pulumi/random": "^4.21.6",
        "@react-email/preview": "^0.0.14",
        "@react-email/preview-server": "5.2.10",
        "@tailwindcss/postcss": "^4.3.4",
        "@types/bcrypt": "^6.0.0",
        "@types/canvas-confetti": "^1.9.0",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^26.6.6",
        "@types/node-fetch": "^2.6.13",
        "@types/pg": "^8.23.1",
