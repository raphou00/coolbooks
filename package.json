{
    "name": "coolbooks",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "next lint",
        "type-check": "tsc --noEmit",
        "wip": "bun run fmt:write && git add . && git commit -m \"WIP\" && git push",
        "fmt:write": "prettier --write \"**/*.{ts,tsx,mdx,json}\" --cache --experimental-ternaries",
        "fmt:check": "prettier --check \"**/*.{ts,tsx,mdx,json}\" --cache",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "db:seed": "prisma db seed",
        "pulumi:login": "cd aws && pulumi login s3://coolbooks-pulumi-state-2921",
        "deploy:dev": "bun run pulumi:login && cd aws && pulumi up --stack dev -y",
        "destroy:dev": "bun run pulumi:login && cd aws && pulumi down --stack dev -y"
    },
    "dependencies": {
        "@aws-sdk/client-lambda": "^3.920.0",
        "@aws-sdk/client-s3": "^3.744.0",
        "@hookform/resolvers": "^5.2.2",
        "@lucia-auth/adapter-prisma": "^4.0.1",
        "@pilcrowjs/object-parser": "^0.0.4",
        "@prisma/client": "5.22.0",
        "@radix-ui/react-select": "^2.1.6",
        "@react-email/components": "^0.0.25",
        "@stripe/react-stripe-js": "^3.4.0",
        "@stripe/stripe-js": "^6.1.0",
        "@t3-oss/env-nextjs": "^0.11.1",
        "@upstash/ratelimit": "^2.0.5",
        "@upstash/redis": "^1.34.8",
        "@vercel/functions": "^1.4.2",
        "ai": "^5.0.76",
        "arctic": "^3.6.0",
        "autoprefixer": "^10.4.21",
        "axios": "^1.13.2",
        "bcrypt": "^5.1.1",
        "caniuse-lite": "^1.0.30001707",
        "canvas-confetti": "^1.9.4",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "dotenv": "^16.4.7",
        "fabric": "^6.6.1",
        "framer-motion": "^11.11.8",
        "input-otp": "^1.2.4",
        "jspdf": "^3.0.3",
        "lucia": "^3.2.1",
        "lucide-react": "^0.452.0",
        "markdown-it": "^14.1.0",
        "marked": "^16.4.1",
        "motion": "^12.4.11",
        "next": "^15.3.5",
        "next-intl": "^4.3.1",
        "next-themes": "^0.4.4",
        "openai": "^6.3.0",
        "pdf-lib": "^1.17.1",
        "pdfkit": "^0.17.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.53.1",
        "react-hot-toast": "^2.4.1",
        "resend": "^4.1.2",
        "screenfull": "^6.0.2",
        "sharp": "^0.34.5",
        "stripe": "^19.3.1",
        "swr": "^2.3.6",
        "tailwind-merge": "^2.5.3",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@pulumi/aws": "^6.68.0",
        "@pulumi/pulumi": "^3.149.0",
        "@pulumi/random": "^4.17.0",
        "@react-email/preview": "^0.0.12",
        "@react-email/preview-server": "4.2.3",
        "@tailwindcss/postcss": "^4.1.11",
        "@types/bcrypt": "^5.0.2",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^20",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "@typescript-eslint/eslint-plugin": "^8.8.1",
        "@typescript-eslint/parser": "^8.8.1",
        "daisyui": "^5.0.43",
        "eslint": "^8",
        "eslint-config-next": "14.2.14",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react-compiler": "^19.1.0-rc.2",
        "eslint-plugin-tailwindcss": "^3.17.5",
        "mime": "^4.0.4",
        "postcss": "^8.5.6",
        "prettier": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.6.8",
        "prisma": "5",
        "tailwindcss": "^4.1.11",
        "ts-node": "^10.9.2",
        "typescript": "^5",
        "vercel": "^37.7.0"
    },
    "lint-staged": {
        "*.{ts,tsx,md,mdx}": [
            "prettier --write \"**/*.{ts,tsx,mdx}\" --cache"
        ],
        "*.{ts,tsx,mdx}": [
            "eslint --fix ."
        ]
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "prisma": {
        "seed": "node prisma/seed.js"
    }
}
